{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Latch Studio window",
  "windows": ["studio", "context-bar"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "codex://threads/*" }]
    },
    "shell:allow-open"
  ]
}
