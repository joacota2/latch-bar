{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Latch Bar",
  "version": "0.3.0",
  "identifier": "com.latchbar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "sh scripts/check-macos-release-signing.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "studio",
        "title": "Latch Bar",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true
      },
      {
        "label": "context-bar",
        "title": "Latch Context Bar",
        "width": 420,
        "height": 58,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled",
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Codex profiles for any selected context",
    "longDescription": "Select text in any application and run a permission-scoped Codex profile beside it.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MjJDQ0ZBOERBNzJENjYKUldSbUxhZU4rc3dpWnk5d3V2amdsOTljcjIreEdCRDkyN3BXcHVWYW1NS0hteVgwdzZMZ0pRMzEK",
      "endpoints": [
        "https://github.com/joacota2/latch-bar/releases/latest/download/latest.json"
      ]
    }
  }
}
