{
  "name": "latch-bar",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "scripts": {
    "check:version": "node scripts/check-version.mjs",
    "licenses:generate": "python3 scripts/third-party.py generate",
    "licenses:check": "python3 scripts/third-party.py check",
    "licenses:bundle": "python3 scripts/third-party.py bundle",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p '*_test.py'",
    "test:watch": "vitest",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "test:browser": "playwright test",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.3.0",
    "focus-trap": "^8.2.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wicg-inert": "^3.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
